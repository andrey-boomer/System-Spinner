    "For complite work you need to allow System Spinner to use special privileges for keydoard mapping." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكي يعمل التطبيق بالكامل، امنح System Spinner صلاحيات خاصة لتعيين لوحة المفاتيح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für den vollen Funktionsumfang benötigt System Spinner besondere Rechte für die Tastaturzuordnung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For complite work you need to allow System Spinner to use special privileges for keydoard mapping."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
